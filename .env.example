# Application
APP_NAME=Sourcely
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0

# Agent
MAX_AGENT_STEPS=5

# Service URLs (Docker internal)
DOCS_SERVICE_URL=http://docs-service:8002
WEBGUIDE_SERVICE_URL=http://webguide-service:8003
SCANNER_SERVICE_URL=http://scanner-service:8004
SANDBOX_BASE_URL=http://sandbox-service:8001

# Web Search
SEARXNG_SECRET=replace_with_a_random_secret
SEARXNG_BASE_URL=http://localhost:8080

# Sandbox
SANDBOX_API_KEY=your_generated_secret_here